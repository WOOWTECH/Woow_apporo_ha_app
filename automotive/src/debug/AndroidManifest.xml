<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application tools:ignore="MissingApplicationIcon">

        <!--
        Debug-only deep link scheme. The debug build has its own applicationId suffix
        (".debug"), so it can be installed next to the release build. Without a scheme of
        its own, every "apporoaiot://" link would raise a disambiguation dialog and could
        open the wrong build. Links aimed at a development build therefore use
        "apporoaiot-dev://", which only this build type declares.

        These filters are additive: the debug build still answers "apporoaiot://" too,
        because a source set manifest can add an intent-filter but cannot rewrite the one
        declared in the main manifest. Full separation needs a manifest placeholder in the
        Gradle build files.
        -->
        <activity android:name=".launch.LaunchActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="apporoaiot-dev"
                    android:host="navigate" />
            </intent-filter>
        </activity>

        <activity android:name=".launch.link.LinkActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="apporoaiot-dev"
                    android:host="invite" />
            </intent-filter>
        </activity>

        <activity android:name=".settings.wear.SettingsWearActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="apporoaiot-dev"
                    android:host="wear-phone-signin" />
            </intent-filter>
        </activity>
    </application>

</manifest>
